# このファイルをコピーして terraform.tfvars を作成し、実際の値を入力する（terraform.tfvars は Git に含めない）
# cp terraform.tfvars.example terraform.tfvars

ssh_public_key      = "ssh-ed25519 AAAA... (自分の公開鍵の中身。例: cat ~/.ssh/bookshelf-aws-ec2.pub)"
my_ip_cidr          = "203.0.113.1/32"                   # SSH を許可する自分のグローバルIP/32（例: curl -s https://checkip.amazonaws.com で確認）
db_password         = "change-me-to-a-random-password"   # RDS の管理者パスワード（12文字以上。/ @ " と空白は使えない）
basic_auth_password = "change-me-to-another-password"    # 画面の Basic 認証のパスワード（12文字以上）
# basic_auth_user   = "bookshelf"                        # Basic 認証のユーザー名（省略時は bookshelf）
# auto_stop_time    = "00:00"                            # EC2 を毎日自動で停止する時刻（日本時間）
